# Anthropic Claude APIキー（必須）
# https://console.anthropic.com/ で取得してください。
# サーバーサイド(Expo Router API Route)でのみ使用され、クライアントには含まれません。
ANTHROPIC_API_KEY=

# 使用するモデル（任意・省略時は claude-sonnet-5）
# コストを抑えたい場合は claude-haiku-4-5 に変更してください。
ANTHROPIC_MODEL=claude-sonnet-5

# 危機介入画面（app/crisis.tsx）の電話番号をテスト用ダミーに差し替える開発者向けフラグ。
# true にすると、よりそいホットライン・いのちの電話・119がすべてダミー番号になり、
# 誤って実際の窓口や救急に発信してしまう事故を防げます。
# 【重要】本番リリース時は必ずこの行を削除するか false にしてください。
EXPO_PUBLIC_CRISIS_TEST_MODE=true
